<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Invalid Credentials</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0d1117;
        color: white;
        font-family: Arial, sans-serif;
      }

      .error-card {
        width: 450px;
        padding: 45px 35px;
        text-align: center;
        background: #161b22;
        border: 1px solid #30363d;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
      }

      .error-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background: #dc3545;
        font-size: 40px;
        font-weight: bold;
      }

      h1 {
        margin-bottom: 15px;
        color: #ff4d5e;
        font-size: 30px;
      }

      p {
        margin-bottom: 30px;
        color: #8b949e;
        font-size: 16px;
      }

      .login-btn {
        display: inline-block;
        padding: 12px 30px;
        border-radius: 8px;
        background: #0d6efd;
        color: white;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
      }

      .login-btn:hover {
        background: #0b5ed7;
      }
    </style>
  </head>

  <body>
    <div class="error-card">
      <div class="error-icon">!</div>

      <h1>Invalid Credentials</h1>

      <p>The email or password you entered is incorrect. Please try again.</p>

      <a href="/" class="login-btn"> Back to Login </a>
    </div>
  </body>
</html>
