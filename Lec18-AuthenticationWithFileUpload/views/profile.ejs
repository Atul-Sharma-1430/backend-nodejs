<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Profile</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #0d1117;
        color: white;
      }

      .profile-card {
        width: 500px;
        padding: 40px;
        border-radius: 20px;
        background: #161b22;
        border: 1px solid #30363d;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
      }

      .welcome {
        text-align: center;
        margin-bottom: 30px;
        font-weight: 600;
      }

      .welcome span {
        color: #0d6efd;
      }

      .profile-img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid #0d6efd;
        display: block;
        margin: 0 auto 30px;
      }

      .user-info {
        background: #0d1117;
        padding: 18px 20px;
        border-radius: 12px;
        border: 1px solid #30363d;
      }

      .user-info p {
        margin: 8px 0;
        font-size: 17px;
      }

      .label {
        color: #8b949e;
        font-weight: 500;
      }
    </style>
  </head>

  <body>
    <div class="profile-card">
      <h1 class="welcome">Welcome, <span><%= user.name %></span></h1>

      <img src="<%= user.imgUrl %>" alt="Profile Picture" class="profile-img" />

      <div class="user-info">
        <p>
          <span class="label">Name:</span>
          <%= user.name %>
        </p>

        <p>
          <span class="label">Email:</span>
          <%= user.email %>
        </p>
      </div>

      <div class="d-flex justify-content-center my-1.5 mt-3">
        <a href="/" class="btn btn-danger mx-3">logout</a>
      </div>
    </div>
  </body>
</html>
