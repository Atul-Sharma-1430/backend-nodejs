<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>URL Shortner</title>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />

    <link rel="stylesheet" href="style.css" />
  </head>

  <body>
    <div class="container">
      <h1 class="h1">URL Shortner</h1>

      <form action="/get-short-url" method="post">
        <!-- <label for="url-input">Enter Your URL</label> -->
        <input
          type="text"
          id="url-input"
          name="longurl"
          placeholder="Enter your URL here"
          required
        />

        <br /><br />
        <button type="submit">Get Short URL</button>
        <br />
      </form>

      <% if (shortURL) { %>
        <div class="short-url">
          <span>Short URL :-</span>

          <a href="<%= shortURL %>" target="_blank" id="short-url">
            <%= shortURL %>
          </a>

          <button type="button" onclick="copyUrl()">
            <i class="fa-regular fa-copy"></i>
            <p id="message">Copy to clipboard</p>
          </button>
        </div>
      <% } %>

      <div></div>
    </div>

    <script>
      function copyUrl() {
        const urlValue = document.getElementById("short-url").innerText;
        navigator.clipboard.writeText(urlValue);

        const newMessage = "Link Copied !!";
        document.getElementById("message").innerText= newMessage;
        document.getElementById("message").style.backgroundColor = "green";
        document.getElementById("message").style.color = "white";
      }
    </script>
  </body>
</html>